# ── Application Environment ──────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_API_URL=http://127.0.0.1:5000
NEXT_PUBLIC_API_URL=http://localhost:5000

# ── Firebase Client SDK (Exposed to browser bundle safely) ──────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ── Firebase Admin SDK (Server-Side ONLY — Never expose to browser) ─────
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── Firebase Local Emulator (Optional for offline dev/tests) ───────────
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# ── OpenAI Integration (Server-Side ONLY) ──────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_SUMMARY_MODEL=gpt-4o-mini
ALLOW_MOCK_AI=true
ALLOW_MOCK_TRANSCRIPTION=true

# ── Cron & Automated Tasks Security ────────────────────────────────────
CRON_SECRET=your_random_secure_cron_secret_here

# ── Data Migration (Only required when running npm run migrate) ─────────
MONGODB_URI=mongodb://localhost:27017/anfaal
