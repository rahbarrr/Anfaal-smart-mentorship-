{
  "name": "anfaal-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx src/worker.ts",
    "benchmark:transcription": "tsx src/scripts/transcriptionBenchmark.ts",
    "verify:release": "npm run build && npm test && tsx src/scripts/releaseReadiness.ts",
    "test": "tsx --test src/**/*.test.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@supabase/supabase-js": "2.57.4",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "@types/bcryptjs": "^2.4.1",
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "tsx": "^4.23.13"
  }
}
