MONGODB_URI=mongodb://localhost:27017/anfaal
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
CLIENT_URL=http://localhost:5173
STORAGE_PROVIDER=mock
STORAGE_BUCKET=anfaal-recordings
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# OpenAI Real AI Settings (Whisper & GPT-4o-mini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Optional override keys
TRANSCRIPTION_API_KEY=
AI_API_KEY=

NODE_ENV=development
SEED_DEMO_DATA=true

# Only used for a first production administrator. Remove these values after
# that administrator has been created.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
