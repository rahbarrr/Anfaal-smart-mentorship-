# Copy this file to backend/.env.production and fill every value before deploy.
MONGODB_URI=mongodb://mongo:27017/anfaal
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-domain.example

# Set these only for the first deployment; remove them after the administrator
# account has been created.
BOOTSTRAP_ADMIN_EMAIL=admin@your-domain.example
BOOTSTRAP_ADMIN_PASSWORD=use-a-strong-unique-password

STORAGE_PROVIDER=mock
STORAGE_BUCKET=anfaal-recordings
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
