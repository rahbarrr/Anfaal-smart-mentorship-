# Production Environment Configuration for Render (Web Service & Background Worker)
NODE_ENV=production
PORT=10000
CLIENT_URL=https://your-app.vercel.app

# Security & Authentication
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/anfaal_production?retryWrites=true&w=majority

# Background Queue (Redis for BullMQ)
REDIS_URL=rediss://default:<password>@<host>:<port>

# AWS S3 (Private Call Recordings)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
STORAGE_BUCKET=anfaal-call-recordings-production

# AI Services (OpenAI Whisper & GPT)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_MODEL=gpt-4o-mini

# Initial Admin Bootstrap (Optional for first startup only, remove after admin is created)
BOOTSTRAP_ADMIN_EMAIL=admin@anfaalfoundation.com
BOOTSTRAP_ADMIN_PASSWORD=StrongAdminPassword!2026

